# Frontend image build context exclusions.
# Keep runtime secrets, backend-only files, local caches, and generated output
# out of the frontend Docker build context.
**/.env
**/.env.*

# The backend image uses ./backend as its own build context; the frontend image
# only needs the TypeScript/Vite app and nginx config.
backend
node_modules
dist
.git
.gitignore
docs
scripts
**/__pycache__
**/*.pyc
backend/.venv
backend/alembic/versions/__pycache__
.vscode
.idea
*.log
