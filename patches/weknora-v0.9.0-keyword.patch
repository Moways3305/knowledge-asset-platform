@@ -0,0 +1,95 @@
+package postgres
+
+import (
+	"context"
+	"errors"
+	"regexp"
+	"strings"
+	"testing"
+
+	"github.com/DATA-DOG/go-sqlmock"
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/stretchr/testify/require"
+	"gorm.io/gorm"
+)
+
+func expectKeywordPlanBegin(mock sqlmock.Sqlmock, mode string) {
+	mock.ExpectBegin()
+	mock.ExpectQuery("SHOW plan_cache_mode").WillReturnRows(sqlmock.NewRows([]string{"plan_cache_mode"}).AddRow(mode))
+	mock.ExpectExec("SET LOCAL plan_cache_mode = force_custom_plan").WillReturnResult(sqlmock.NewResult(0, 0))
+}
+
+func expectKeywordPlanEnd(mock sqlmock.Sqlmock, mode string) {
+	mock.ExpectExec(regexp.QuoteMeta("SELECT set_config('plan_cache_mode', $1, true)")).WithArgs(mode).WillReturnResult(sqlmock.NewResult(0, 0))
+	mock.ExpectCommit()
+}
+
+func TestMaterializedKeywordScopeAndLimit(t *testing.T) {
+	params := types.RetrieveParams{Query: "quote' OR true --", TopK: 500,
+		KnowledgeBaseIDs: []string{"kb-1", "kb-2"}, KnowledgeIDs: []string{"doc-1", "doc-2"},
+		TagIDs: []string{"tag-1"}, ExcludeGeneratedQuestionKBIDs: []string{"kb-1"}}
+	statement, values, err := materializedKeywordSQL(params, "paradedb.score")
+	require.NoError(t, err)
+	require.Contains(t, statement, "WITH scored AS MATERIALIZED")
+	require.Equal(t, 1, strings.Count(statement, "LIMIT"))
+	require.Less(t, strings.Index(statement, "FROM scored WHERE"), strings.Index(statement, "source_id <> chunk_id"))
+	require.Less(t, strings.Index(statement, "source_id <> chunk_id"), strings.Index(statement, "LIMIT"))
+	require.NotContains(t, statement, params.Query)
+	require.Equal(t, []interface{}{"kb-1", "kb-2", "doc-1", "doc-2", "tag-1", params.Query, true, "kb-1", params.TopK}, values)
+	_, _, err = materializedKeywordSQL(params, "untrusted.score")
+	require.Error(t, err)
+}
+
+func TestMaterializedKeywordExecutionRestoresCallerMode(t *testing.T) {
+	for _, mode := range []string{"auto", "force_generic_plan", "force_custom_plan"} {
+		t.Run(mode, func(t *testing.T) {
+			repo, mock := newKeywordTestRepository(t)
+			mock.ExpectQuery(regexp.QuoteMeta(keywordScoreFunctionSQL)).WillReturnRows(sqlmock.NewRows([]string{"score_function"}).AddRow("paradedb.score"))
+			expectKeywordPlanBegin(mock, mode)
+			mock.ExpectQuery(`WITH scored AS MATERIALIZED.*knowledge_base_id IN \(\$1,\$2\).*FROM scored WHERE NOT.*LIMIT \$6`).
+				WithArgs("kb-1", "kb-2", "项目", true, "kb-1", 500).
+				WillReturnRows(sqlmock.NewRows([]string{"id", "chunk_id", "score"}).AddRow(1, "body", 10))
+			expectKeywordPlanEnd(mock, mode)
+			results, err := repo.KeywordsRetrieve(context.Background(), types.RetrieveParams{Query: "项目", TopK: 500,
+				KnowledgeBaseIDs: []string{"kb-1", "kb-2"}, ExcludeGeneratedQuestionKBIDs: []string{"kb-1"}})
+			require.NoError(t, err)
+			require.Equal(t, "body", results[0].Results[0].ChunkID)
+		})
+	}
+}
+
+func TestKeywordPlanSetupAndRestoreFailuresFailClosed(t *testing.T) {
+	for _, phase := range []string{"show", "set", "query", "restore"} {
+		t.Run(phase, func(t *testing.T) {
+			repo, mock := newKeywordTestRepository(t)
+			cause := errors.New("fixture failure")
+			mock.ExpectBegin()
+			show := mock.ExpectQuery("SHOW plan_cache_mode")
+			if phase == "show" {
+				show.WillReturnError(cause)
+			} else {
+				show.WillReturnRows(sqlmock.NewRows([]string{"plan_cache_mode"}).AddRow("auto"))
+				set := mock.ExpectExec("SET LOCAL plan_cache_mode = force_custom_plan")
+				if phase == "set" {
+					set.WillReturnError(cause)
+				} else {
+					set.WillReturnResult(sqlmock.NewResult(0, 0))
+				}
+			}
+			if phase == "restore" {
+				mock.ExpectExec(regexp.QuoteMeta("SELECT set_config('plan_cache_mode', $1, true)")).WithArgs("auto").WillReturnError(cause)
+			}
+			mock.ExpectRollback()
+			called := false
+			err := repo.withKeywordPlan(context.Background(), func(tx *gorm.DB) error {
+				called = true
+				if phase == "query" {
+					return cause
+				}
+				return nil
+			})
+			require.ErrorIs(t, err, cause)
+			require.Equal(t, phase == "query" || phase == "restore", called)
+		})
+	}
+}
