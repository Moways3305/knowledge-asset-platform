# 前端 server 块模板。容器启动时由 nginx 镜像的 envsubst 入口
# （/etc/nginx/templates/*.template → /etc/nginx/conf.d/）渲染，仅替换 ${ONLYOFFICE_ORIGIN}
# （受 NGINX_ENVSUBST_FILTER 约束；nginx 自身的 $host/$uri 等不是环境变量，不会被替换）。
#
# 静态托管 Vite dist + 同源反代后端。同源部署下前端用相对路径调用 /api/v1、/health*、
# /admin/ops；httpOnly 会话 cookie 同源天然可用。不含任何 secret / 后端内网真实地址（仅 Docker DNS）。
# 非 root 运行：监听非特权端口 8080（compose 宿主映射 18080:8080）。

server {
    listen 8080;
    server_name _;

    # 不回显 nginx 版本（响应头与错误页）。
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    # 允许 Path B 上传（后端上限 25 MiB），放宽代理体积上限。
    client_max_body_size 30m;

    # Docker Compose 内置 DNS。使用变量 proxy_pass 让 nginx 在请求期解析 backend，
    # 避免容器启动瞬间服务名未就绪导致 nginx 直接退出。
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $kap_backend http://backend:8000;

    # 反代统一转发头（server 级，被下方 proxy location 继承）。
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_http_version 1.1;

    # ---- 安全响应头（server 级；含 always 覆盖错误响应）----
    # 注意 nginx add_header 继承规则：某 location 一旦自带 add_header，会丢弃所有继承的
    # add_header。故 /assets/ 不自带 add_header（仅 expires）以继承这些头；而 = /index.html
    # 因需自定义 Cache-Control，必须在其块内重复这组安全头（index.html 是被 iframe 嵌入、
    # 最需要 CSP / X-Frame-Options 的文档）。
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header X-XSS-Protection "0" always;
    # HSTS 仅在 HTTPS 下被浏览器采纳；HTTP 本地开发下浏览器按规范忽略，不破坏开发。
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    # CSP 兼容 ONLYOFFICE Document Server iframe 嵌入：frame-src/connect-src 预留
    # ${ONLYOFFICE_ORIGIN}（未配置时为空，等价仅 'self'）。style-src 含 'unsafe-inline'
    # 以容纳 Vite 构建产物内联 style。
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; frame-src 'self' ${ONLYOFFICE_ORIGIN}; connect-src 'self' ${ONLYOFFICE_ORIGIN}; object-src 'none'; base-uri 'self'; form-action 'self'" always;

    # 登录端点：单独严格限速（防爆破）。
    location = /api/v1/auth/login {
        limit_req zone=api_login burst=10 nodelay;
        proxy_pass $kap_backend;
    }

    # 业务 API（保留完整原始路径 /api/v1/... 转发到后端）。
    location /api/v1/ {
        limit_req zone=api_all burst=50 nodelay;
        proxy_pass $kap_backend;
    }

    # 健康探针（liveness / readiness / 安全配置诊断）。前缀匹配覆盖 /health、/health/ready、/health/config。
    location /health {
        proxy_pass $kap_backend;
    }

    # 运营端点（ops summary 当前挂在 root 路径，不在 /api/v1 下）。
    location /admin/ops/ {
        proxy_pass $kap_backend;
    }

    # 带 hash 的静态资源长缓存。仅用 expires（不自带 add_header），以继承上面的安全响应头。
    location /assets/ {
        try_files $uri =404;
        expires 30d;
    }

    # index.html 不缓存，保证发新版即时生效。因自带 Cache-Control，需重复安全响应头。
    location = /index.html {
        add_header Cache-Control "no-cache" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header X-XSS-Protection "0" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; frame-src 'self' ${ONLYOFFICE_ORIGIN}; connect-src 'self' ${ONLYOFFICE_ORIGIN}; object-src 'none'; base-uri 'self'; form-action 'self'" always;
    }

    # SPA 路由 fallback：非 API/静态路径回退到 index.html，由前端路由接管。
    location / {
        try_files $uri $uri/ /index.html;
    }
}
