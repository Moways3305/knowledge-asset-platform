# Managed KAP host Nginx site. Render and install only through
# deploy/install-host-nginx.sh so nginx -t and rollback are always applied.
upstream kap_frontend {
    server 127.0.0.1:18080;
    keepalive 16;
}

server {
    listen 443 ssl http2;
    server_name __KAP_SERVER_NAME__;

    ssl_certificate __KAP_TLS_CERTIFICATE__;
    ssl_certificate_key __KAP_TLS_CERTIFICATE_KEY__;

    server_tokens off;
    client_max_body_size 1m;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_http_version 1.1;

    location = /api/v1/ingest/upload {
        client_max_body_size 32m;
        client_body_timeout 120s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
        proxy_pass http://kap_frontend;
    }

    location ^~ /api/v1/ingest/upload-sessions {
        client_max_body_size 32m;
        client_body_timeout 120s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
        proxy_pass http://kap_frontend;
    }

    location / {
        proxy_pass http://kap_frontend;
    }
}
