{
  "name": "knowledge-asset-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint src",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui:model-autofill": "node scripts/model-autofill.ui-qa.mjs",
    "test:ui:project-settings": "node scripts/project-settings.ui-qa.mjs",
    "test:ui:knowledge-list": "node scripts/knowledge-list.ui-qa.mjs",
    "test:ui:cross-project-summary": "node scripts/cross-project-summary.ui-qa.mjs",
    "test:ui:knowledge-detail": "node scripts/knowledge-detail.ui-qa.mjs",
    "test:ui:upload": "node scripts/upload-ingest.ui-qa.mjs",
    "test:ui:project-space": "node scripts/project-space.ui-qa.mjs",
    "test:ui:project-knowledge": "node scripts/project-knowledge.ui-qa.mjs",
    "test:ui:review-access": "node scripts/review-access.ui-qa.mjs",
    "test:ui:workbench": "node scripts/workbench.ui-qa.mjs",
    "test:ui:personal-knowledge": "node scripts/personal-knowledge.ui-qa.mjs",
    "test:ui:admin-operations": "node scripts/admin-operations.ui-qa.mjs",
    "test:ui:model-foundation": "node scripts/model-foundation.ui-qa.mjs",
    "test:ui:wecom-scan": "node scripts/wecom-scan.ui-qa.mjs",
    "test:ui:audit-security": "node scripts/security-operations.ui-qa.mjs",
    "test:ui:people-permissions": "node scripts/people-permissions.ui-qa.mjs",
    "test:ui:help-global": "node scripts/help-global-experience.ui-qa.mjs",
    "test:ui:global-acceptance": "node --test scripts/global-frontend-acceptance.coverage.test.mjs scripts/ui-qa-process.test.mjs && node scripts/global-frontend-acceptance.ui-qa.mjs",
    "test:ui:naming-rules": "node scripts/naming-rules-scoped.ui-qa.mjs",
    "api:export": "python scripts/export_openapi.py"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.2.9",
    "@fontsource/hanken-grotesk": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "lucide-react": "^1.17.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "6.30.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "prettier": "^3.8.4",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^6.0.1",
    "vitest": "^2.1.9"
  }
}
