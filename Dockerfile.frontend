# Frontend production image:
# Build the Vite static bundle, then serve it with nginx as a non-root user.
# The frontend uses same-origin relative API paths; nginx proxies API requests to the backend service.
# Do not copy backend/.env or any runtime secrets into this image.

# ---- build stage ----
FROM node:20-alpine AS build
WORKDIR /app

# Install dependencies first to improve Docker layer caching.
COPY package.json package-lock.json ./
RUN npm ci

# Copy source after dependencies. Runtime env files, backend code, build output,
# and local caches are excluded by .dockerignore.
COPY . .

# Leave VITE_API_BASE_URL unset by default so the bundle calls same-origin
# /api/v1 paths; nginx is responsible for routing those requests.
RUN npm run build

# Same identity as the backend image; public, no release text or secrets.
ARG KAP_RELEASE_MANIFEST_B64=""
RUN node -e "const fs=require('fs'); const raw=process.env.KAP_RELEASE_MANIFEST_B64; if(raw){const m=JSON.parse(Buffer.from(raw,'base64').toString('utf8'));fs.writeFileSync('dist/release-identity.json',JSON.stringify({version:m.version,commit:m.commit}));}"

# ---- serve stage ----
FROM nginx:1.27-alpine

# Main config (http-level: gzip / rate-limit zones / temp paths / logs) plus the
# server block as an envsubst template. The nginx image entrypoint renders
# /etc/nginx/templates/*.template -> /etc/nginx/conf.d/ at startup, substituting
# only ${ONLYOFFICE_ORIGIN} (constrained by NGINX_ENVSUBST_FILTER).
COPY deploy/nginx-main.conf /etc/nginx/nginx.conf
COPY deploy/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY --chmod=0555 deploy/validate-onlyoffice-origin.sh /docker-entrypoint.d/19-validate-onlyoffice-origin.sh
COPY --from=build /app/dist /usr/share/nginx/html

# Run as the image's unprivileged `nginx` user (uid 101). Grant write access to the
# paths a non-root master/worker needs: pid -> /tmp (see nginx.conf), temp dirs under
# /var/cache/nginx, the rendered conf.d target, and the static root.
RUN chown -R nginx:nginx /var/cache/nginx /etc/nginx/conf.d /usr/share/nginx/html

# The 19-* entrypoint script rejects anything except one exact HTTP(S) origin
# before nginx's 20-envsubst-on-templates.sh runs. Only ONLYOFFICE_ORIGIN is
# substituted; default empty makes the CSP sources collapse to 'self'.
ENV NGINX_ENVSUBST_FILTER=ONLYOFFICE_ORIGIN \
    ONLYOFFICE_ORIGIN=

USER nginx

# Non-privileged port (compose maps host 18080 -> 8080).
EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
