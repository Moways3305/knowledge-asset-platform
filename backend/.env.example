# Backend environment example.
# Copy to .env for local development. Do NOT put real secrets here.

# Application
APP_NAME=knowledge-asset-platform
APP_ENV=local
LOG_LEVEL=INFO

# 会话 / OAuth state cookie 的 Secure 标志（生产安全守卫）。
# 留空：按环境推断——APP_ENV=prod 强制 Secure=True（HTTPS-only），非 prod 默认 False
#   （便于 http://localhost 调试）。
# prod 下即使显式置 false 运行时仍被强制为安全；但 /health/config 会把它标记为
#   production_blocker（SESSION_COOKIE_SECURE），提示改回 true / 删除该项。
# SESSION_COOKIE_SECURE=

# 登录失败风控。AUTH_ATTEMPT_HASH_SECRET 仅用于对登录标识 / IP 做 HMAC 不可逆
#   hash（绝不进响应/审计/前端）；prod 必须配置（缺失 → /health/config production_blocker
#   AUTH_ATTEMPT_HASH_SECRET），非 prod 留空回退稳定常量。**不要在此填真实 secret。**
# AUTH_ATTEMPT_HASH_SECRET=
# 锁定 / 限流窗口与阈值（<1 的非法值由服务层钳制为安全默认）：
# AUTH_FAILED_WINDOW_MINUTES=15        # identifier 失败统计窗口
# AUTH_MAX_FAILED_ATTEMPTS=5           # 窗口内（自最近成功后）失败达此值进入锁定
# AUTH_LOCKOUT_MINUTES=15              # 锁定持续时长（自最近一次失败尝试起）
# AUTH_IP_FAILED_WINDOW_MINUTES=15     # IP 失败统计窗口
# AUTH_IP_MAX_FAILED_ATTEMPTS=30       # 窗口内 IP 失败达此值触发限流

# CSRF 防护。CSRF_TOKEN_SECRET 仅用于对无状态 CSRF token 做 HMAC 签名（绝不进
#   响应/审计/前端/日志）；prod 必须配置（缺失 → /health/config production_blocker
#   CSRF_TOKEN_SECRET），非 prod 留空回退稳定常量。**不要在此填真实 secret。**
# CSRF_TOKEN_SECRET=
# CSRF_TOKEN_TTL_MINUTES=720            # 签发 token 有效期（分钟），<1 回退默认

# PostgreSQL (async driver). Local-dev credentials only.
DATABASE_URL=postgresql+asyncpg://dev:devpassword@localhost:5432/knowledge_platform

# Redis (Celery broker / result backend)
REDIS_URL=redis://localhost:6379/0

# Celery 异步治理作业。broker / backend 缺省回退到 REDIS_URL。
# CELERY_TASK_ALWAYS_EAGER=true（默认）：无 worker 也能跑（入库处理内联同步执行）。
# 接 worker 时设为 false 启用真正异步（work 排队，由 worker 进程执行）。
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_TASK_ALWAYS_EAGER=true

# 企业微信 OAuth 身份 + 微盘扫描。corp_id + app_secret 配齐才启用真实集成；
# 缺失则 OAuth 端点返回未配置、扫描走 Null/注入 fake。**app_secret 绝不外泄**。
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_APP_SECRET=
WECOM_REDIRECT_URI=
WECOM_DRIVE_BASE_URL=https://qyapi.weixin.qq.com
WECOM_SCAN_PAGE_SIZE=100
WECOM_TIMEOUT=30
# 开启后治理通知按 wecom 渠道落库并由 worker 真实下发；默认关（仅本地 in_app）。
WECOM_NOTIFY_ENABLED=false

# ONLYOFFICE 只读预览。enabled + document_server_url 配齐才出真实只读预览配置。
# jwt_secret 绝不外泄；internal_base_url 用于拼受控取件 URL 供 Document Server 回取。
ONLYOFFICE_ENABLED=false
ONLYOFFICE_DOCUMENT_SERVER_URL=
ONLYOFFICE_INTERNAL_BASE_URL=
ONLYOFFICE_JWT_SECRET=
ONLYOFFICE_FETCH_TTL_MINUTES=30

# 受控本地文件存储根目录（dev/test）。Path B 上传的文件字节写入此处；
# 内部存储引用为 server-only，不进入任何 API 响应。生产应替换为对象存储后端。
# 清理本地上传：删除该目录即可（已在 .gitignore 忽略）。
STORAGE_ROOT=./_local_storage

# WeKnora 知识底座。base_url + api_key 同时配置时启用真实集成；任一为空则
# 降级跳过索引（dev 无 WeKnora 仍可起 app 与 confirm）。API Key 绝不进响应/审计/日志。
# embedding 模型全平台统一、建库后不可改（WeKnora 跨 KB 检索硬约束）。
WEKNORA_BASE_URL=
WEKNORA_API_KEY=
WEKNORA_EMBEDDING_MODEL_ID=
# 建库后随 KB 初始化写入的可选模型 id（chat/rerank/multimodal）。配置则一并初始化，
# 确保 KB 一建即可用；只填 embedding 也会初始化。值是 WeKnora 已注册模型的 id（非密钥）。
WEKNORA_CHAT_MODEL_ID=
WEKNORA_RERANK_MODEL_ID=
WEKNORA_MULTIMODAL_MODEL_ID=
# summary 模型当前不参与建库/初始化（OQ3：摘要走平台外部 LLM）；保留仅兼容，可留空。
WEKNORA_SUMMARY_MODEL_ID=
WEKNORA_TENANT_ID=
WEKNORA_TIMEOUT=30
# 模型配置中心把 server-only model_id 经单向 HMAC 映射成对前端不可逆的 model_ref 的
# HMAC key。仅后端可读，不入响应/审计/前端。留空仅作 dev 兜底（回退稳定常量）；**生产必须配置**
# —— 启用 WeKnora 但未配置时 /health/config 的 missing_config 会列出 WEKNORA_MODEL_REF_SECRET。
WEKNORA_MODEL_REF_SECRET=

# 外部 LLM 内容处理。选一个 provider + 其 api_key 即启用；缺失则内容处理降级到
# 确定性草稿（上传不失败）。base_url/model 缺省走注册表默认，可覆盖。API Key 绝不外泄。
# provider 取值：deepseek / kimi / qwen / glm / minimax / openai / custom
LLM_PROVIDER=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT=30
# 仅 MiniMax 需要（OpenAI 兼容通道的 GroupId）
LLM_MINIMAX_GROUP_ID=
