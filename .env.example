# docker-compose 变量插值用环境文件（compose 默认读取项目根 ./.env）。
# 复制为 ./.env 后按需修改：  cp .env.example .env
# 这些值供 compose 在解析期插值（${VAR}），与容器内运行时配置（backend/.env）是两件事。
# 不要在此填真实生产密钥；生产用部署密钥注入（见 backend/README §部署）。

# 复制此示例用于本地开发；生产必须显式改为 prod，并完成生产配置清单。
# Compose 的 environment 优先于 backend/.env，因此此处决定容器运行模式。
APP_ENV=dev
# Compose 必填。仅本地开发占位值；生产通过受保护配置注入独立强随机密码。
POSTGRES_PASSWORD=local-dev-change-me

# 用户实际访问的前端 origin；生产必须为 HTTPS 且不得包含路径或查询参数。
KAP_PUBLIC_BASE_URL=http://localhost:18080

# 普通本地构建的兼容版本；正式部署以 deploy_release.py 写入的发布清单为准。
APP_VERSION=0.1.0

# Optional image-build mirrors: leave BOTH empty to keep the base-image defaults.
# Set in this file or export in the deployment shell, not backend/.env.
# HTTPS only. Configure both repositories; Debian signature verification stays enabled.
# Example: https://mirrors.ustc.edu.cn/debian and https://mirrors.ustc.edu.cn/debian-security
KAP_DEBIAN_MIRROR=
KAP_DEBIAN_SECURITY_MIRROR=

# WorkBuddy remote Streamable HTTP MCP。生产通过 HTTPS 暴露精确路径 /mcp；关闭开关可立即
# 回滚到本地 Connector。Origin 留空表示只允许无 Origin 的原生客户端请求。
WORKBUDDY_REMOTE_MCP_ENABLED=true
WORKBUDDY_REMOTE_MCP_TOOLS=*
WORKBUDDY_REMOTE_TOKEN_TTL_HOURS=168
WORKBUDDY_REMOTE_REQUEST_MAX_BYTES=65536
WORKBUDDY_REMOTE_CONCURRENCY=8
WORKBUDDY_REMOTE_TIMEOUT_SECONDS=35
WORKBUDDY_REMOTE_RATE_LIMIT_PER_MINUTE=60
WORKBUDDY_REMOTE_ALLOWED_ORIGINS=
# Set OAuth configuration in backend/.env; see docs/api/mcp-oauth.md.

# Redis 访问密码。compose 用它给 redis 加 --requirepass，并拼进 backend/worker/beat 的
# REDIS_URL（redis://:${REDIS_PASSWORD}@redis:6379/0）。上线务必改成强随机值。
# 该值直接进入 URL 密码段，使用 URL-safe 随机字符，避免 @、/、# 等未编码字符。
REDIS_PASSWORD=changeme

# 前端 CSP 放行的 ONLYOFFICE Document Server 来源（scheme://host[:port]）。
# 留空＝CSP script-src/frame-src/connect-src 仅 'self'（不开放在线预览）。
# 关键：这是**浏览器**能访问到的 Document Server origin（用户浏览器从此地址加载 iframe/JS SDK），
# 不是容器内 Docker DNS（如 onlyoffice:80 这类只在容器网络可解析的名字会让浏览器加载失败）。
# 一般填生产对外域名，例如 https://onlyoffice.example.com。
ONLYOFFICE_ORIGIN=

# 可选：backend uvicorn worker 进程数（默认 2）。按 CPU 与内存上限实测调整。
# WEB_CONCURRENCY=2

# OCR worker 资源预算：2GiB 容器默认只允许 1 个 prefork 子进程且只预取 1 份。
# concurrency 与容器 memory 必须成套压测，不能单独放大。
OCR_WORKER_CONCURRENCY=1
# Light/default worker: Compose interpolation (root .env), not backend/.env.
# Structured Office/PDF/image parsing stays on the isolated OCR/heavy worker.
# Raise concurrency only after profiling and raising the container memory budget.
INGEST_WORKER_CONCURRENCY=1
# CPU quotas are positive core counts, independent of worker concurrency.
# Set these in root .env or the deployment shell, not backend/.env.
INGEST_WORKER_CPU_LIMIT=0.5
NOTIFICATION_WORKER_CPU_LIMIT=0.25
# Defaults retain the total 1 CPU / 4GiB budget across default/parse/notification.
# parse_worker stays at 0.25 CPU / 512MiB; notification_worker keeps 512MiB and one process.
# Raising a CPU quota increases the total budget; it does not rebalance other consumers.
# Default gets 3GiB; update existing memory overrides to preserve the total memory budget.
# Existing overrides must account for both 512MiB dedicated consumers.
INGEST_WORKER_MEMORY_LIMIT=3072M
# Backend/default/OCR workers share these per-session admission windows.
# Compose injects them from root .env; backend/.env alone cannot override them.
INGEST_PROCESSING_WINDOW=5
INGEST_HEAVY_PROCESSING_WINDOW=1
OCR_WORKER_PREFETCH_MULTIPLIER=1
OCR_WORKER_MAX_TASKS_PER_CHILD=4
OCR_WORKER_MAX_MEMORY_PER_CHILD_KB=700000
INGEST_LEASE_TIMEOUT_SECONDS=900
INGEST_RECOVERY_MAX_ATTEMPTS=3
OCR_RENDER_TIMEOUT_SECONDS=45
OCR_PAGE_TIMEOUT_SECONDS=60
OCR_DOCUMENT_TIMEOUT_SECONDS=600
OCR_MAX_PAGES=100
OCR_MAX_RENDERED_PIXELS=20000000
OCR_MAX_TOTAL_PIXELS=100000000

# WorkBuddy 未签名企业内部版分发开关。所有环境默认 false；仅经管理员批准后在受控服务器
# 显式设为 true。正式签名版不需要开启。
WORKBUDDY_CONNECTOR_ALLOW_INTERNAL=false
